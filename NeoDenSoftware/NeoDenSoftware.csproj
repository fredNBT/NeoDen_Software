<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.ColorDialog (the Layers panel's "click a swatch to change
         that layer's color" picker) - WPF has no built-in color-chooser dialog of its own, and a
         hand-rolled one isn't worth it just to get the standard Windows color grid. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- UseWindowsForms auto-adds global usings for System.Drawing/System.Windows.Forms, which
       collide with WPF's own Brush/Color/Point/Application/KeyEventArgs/MouseEventArgs names
       across the whole project. Removed so those WinForms types must always be referenced by
       their full name (as the ColorDialog code already does) instead of silently shadowing WPF's. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\TapeFeeder.png" />
  </ItemGroup>

</Project>
