<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm chrome built from the board's own materials - FR4 tan, copper accent. -->

    <SolidColorBrush x:Key="Theme.AppBackground" Color="#E7DFC8"/>
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#F1EBDA"/>
    <SolidColorBrush x:Key="Theme.TitleBarBackground" Color="#DCD1B3"/>
    <SolidColorBrush x:Key="Theme.ControlBackground" Color="#F1EBDA"/>
    <SolidColorBrush x:Key="Theme.Border" Color="#C4B78D"/>
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#2B2116"/>
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#786A4E"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="#B5651D"/>
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FBF3E1"/>
    <SolidColorBrush x:Key="Theme.RowAlt" Color="#EAE1C8"/>

    <!-- See FabFloor.xaml for why these SystemColors keys are needed: WPF's built-in MenuItem
         submenu popup (and ToolTip/unstyled popups) pull colors from these via DynamicResource,
         not from any Background/Foreground Setter above. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F1EBDA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#2B2116"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F1EBDA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#2B2116"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F1EBDA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#2B2116"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B5651D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FBF3E1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#B5651D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#C4B78D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#2B2116"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.AppBackground}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Theme.AppBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
    </Style>

    <!-- Full ControlTemplate (see FabFloor.xaml for why a plain Style Setter/SystemColors override
         alone isn't reliable: Aero2, the default Win10/11 theme engine, hardcodes its own submenu
         popup to white regardless of SystemColors). Covers top-level headers, flat dropdown
         children, and flat ContextMenu items. -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="0" VerticalOffset="-1"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource Theme.PanelBackground}"
                                        BorderBrush="{StaticResource Theme.Border}" BorderThickness="1" Padding="2">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="Padding" Value="20,5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Theme.PanelBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Theme.Border}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{StaticResource Theme.PanelBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Theme.TitleBarBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Theme.ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Theme.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Theme.AppBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Theme.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Theme.ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Theme.PanelBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="RowBackground" Value="{StaticResource Theme.PanelBackground}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Theme.RowAlt}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Theme.Border}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Theme.TitleBarBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource Theme.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}"/>
    </Style>

</ResourceDictionary>
