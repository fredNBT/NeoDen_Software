<Window x:Class="NeoDenSoftware.Views.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appearance" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Appearance" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,14"
                   Text="Pick a color theme for the app's menus, toolbar, tabs, and panels. Takes effect immediately and is remembered next time you open the app. The PCB canvas itself always renders the same way, regardless of theme."/>

        <RadioButton GroupName="Theme" IsChecked="{Binding IsOriginal}" Margin="0,0,0,10">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Width="380">
                <StackPanel>
                    <TextBlock Text="Original" FontWeight="SemiBold"/>
                    <TextBlock Text="The default Windows look - no theme applied." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </RadioButton>

        <RadioButton GroupName="Theme" IsChecked="{Binding IsFabFloor}" Margin="0,0,0,10">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Width="380">
                <StackPanel>
                    <TextBlock Text="Fab Floor" FontWeight="SemiBold"/>
                    <TextBlock Text="Dark chrome matching the PCB canvas, soldermask-green accent." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="22" Height="15" Fill="#16181A" Margin="0,0,4,0"/>
                        <Rectangle Width="22" Height="15" Fill="#1D2023" Margin="0,0,4,0"/>
                        <Rectangle Width="22" Height="15" Fill="#3FAE7C"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </RadioButton>

        <RadioButton GroupName="Theme" IsChecked="{Binding IsBenchLight}" Margin="0,0,0,10">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Width="380">
                <StackPanel>
                    <TextBlock Text="Bench Light" FontWeight="SemiBold"/>
                    <TextBlock Text="Clean daylight chrome, circuit-trace blue accent." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="22" Height="15" Fill="#F7F9FA" Stroke="#D7DEE4" Margin="0,0,4,0"/>
                        <Rectangle Width="22" Height="15" Fill="#FFFFFF" Stroke="#D7DEE4" Margin="0,0,4,0"/>
                        <Rectangle Width="22" Height="15" Fill="#1D5FA8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </RadioButton>

        <RadioButton GroupName="Theme" IsChecked="{Binding IsCopperFlux}" Margin="0,0,0,10">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Width="380">
                <StackPanel>
                    <TextBlock Text="Copper &amp; Flux" FontWeight="SemiBold"/>
                    <TextBlock Text="Warm FR4-tan chrome, copper accent." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="22" Height="15" Fill="#E7DFC8" Margin="0,0,4,0"/>
                        <Rectangle Width="22" Height="15" Fill="#F1EBDA" Stroke="#C4B78D" Margin="0,0,4,0"/>
                        <Rectangle Width="22" Height="15" Fill="#B5651D"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </RadioButton>

        <Button Content="Close" HorizontalAlignment="Right" Padding="12,4" Margin="0,8,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
