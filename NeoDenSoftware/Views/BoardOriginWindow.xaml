<Window x:Class="NeoDenSoftware.Views.BoardOriginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Board Origin" Height="220" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Board Origin" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="World-space X/Y (mm) that the board's bottom-left corner is shifted to on Gerber import - the same coordinate frame the mouse position readout reports."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="X (mm):" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <!-- No UpdateSourceTrigger=PropertyChanged - see the matching comment in
                 FootprintLibraryWindow.xaml for why that eats decimal points on a double-typed
                 property. LostFocus (the default) commits the full typed string in one shot. -->
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BoardOriginX}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y (mm):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BoardOriginY}"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" Margin="0,12,0,12"
                   Text="Takes effect on the next Gerber import - it doesn't move a board already on screen."/>
        <Button Content="Close" HorizontalAlignment="Right" Padding="12,4" Click="Close_Click"/>
    </StackPanel>
</Window>
