<Window x:Class="NeoDenSoftware.Views.ComponentLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NeoDenSoftware.Converters"
        Title="Component Library" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <conv:PathToImageSourceConverter x:Key="PathToImageSource"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Component Library" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <!-- Where the data actually lives on disk, shown plainly rather than left to a tooltip or
             a code comment - a read-only but selectable TextBox (not a TextBlock) so the path can
             be copied straight out for a backup or to go find it in Explorer. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Data file:" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0"/>
            <TextBox Text="{Binding ManifestFilePath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" Foreground="Gray" VerticalAlignment="Center"/>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="44" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Draw:" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Where this part is physically stored, e.g. 'Drawer 3' or 'Bin A1'."/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewDraw, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Where this part is physically stored, e.g. 'Drawer 3' or 'Bin A1'."/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <!-- No UpdateSourceTrigger=PropertyChanged on the L/W/H boxes - see
                         FootprintLibraryWindow.xaml's comment for why that eats decimal points
                         mid-type on a double-typed property. Plain LostFocus commits in one shot. -->
                    <TextBlock Grid.Column="0" Text="L (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewLengthMm}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="W (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="3" Text="{Binding NewWidthMm}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="H (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="5" Text="{Binding NewHeightMm}" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Browse Image..." Padding="8,3" Click="BrowseImage_Click"/>
                    <TextBlock Text="{Binding ImagePathDisplay}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Browse Datasheet (PDF)..." Padding="8,3" Click="BrowseDatasheet_Click"/>
                    <TextBlock Text="{Binding DatasheetPathDisplay}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="Orange" VerticalAlignment="Center"
                               Margin="0,0,10,0" TextWrapping="Wrap" MaxWidth="320"/>
                    <Button Content="Clear" Padding="8,3" Command="{Binding CancelEditCommand}"/>
                    <Button Content="{Binding SaveButtonText}" Padding="8,3" Margin="8,0,0,0" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Close" Padding="8,3" Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CanUserDeleteRows explicitly off - see FootprintLibraryWindow.xaml's own comment for
             why: it defaults to True, and with a row selected (which happens automatically here
             just from clicking a row to edit it) an accidental Delete/Backspace keypress would
             remove it from Entries with no confirmation and no connection to the saved file. -->
        <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  RowHeaderWidth="0" RowHeight="44">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Draw" Binding="{Binding Draw}" Width="100"/>
                <DataGridTemplateColumn Header="Photo" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageSource}}"
                                   Width="36" Height="36" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Length (mm)" Binding="{Binding LengthMm}" Width="90"/>
                <DataGridTextColumn Header="Width (mm)" Binding="{Binding WidthMm}" Width="90"/>
                <DataGridTextColumn Header="Height (mm)" Binding="{Binding HeightMm}" Width="90"/>
                <DataGridTemplateColumn Header="STL Tray" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Create STL" Padding="4,2" VerticalAlignment="Center"
                                    ToolTip="Create the parts-tray STL for this component (same tray the NeoDen export makes), using the Tray STL Generator Settings."
                                    Command="{Binding DataContext.CreateTrayStlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Datasheet" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Padding="2" ToolTip="Open datasheet PDF"
                                    Command="{Binding DataContext.OpenDatasheetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <!-- Small hand-drawn PDF icon (page with a folded corner + a red
                                     "PDF" banner) - no image asset needed, consistent with how
                                     every other drawing in this app (footprints, feeders) is
                                     built from plain shapes rather than bitmap resources. -->
                                <Canvas Width="26" Height="32">
                                    <Polygon Points="0,0 17,0 26,9 26,32 0,32" Fill="White" Stroke="#D32F2F" StrokeThickness="1.5"/>
                                    <Polygon Points="17,0 26,9 17,9" Fill="#F5C6C6"/>
                                    <Rectangle Canvas.Top="18" Canvas.Left="0" Width="26" Height="10" Fill="#D32F2F"/>
                                    <TextBlock Canvas.Top="20" Canvas.Left="1" Text="PDF" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Canvas>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <!-- No datasheet uploaded for this row: hide the button
                                                 rather than leaving a dead/always-disabled one. -->
                                            <DataTrigger Binding="{Binding DatasheetPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
