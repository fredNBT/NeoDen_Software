<Window x:Class="NeoDenSoftware.Views.FootprintLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Footprint Library" Height="560" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Footprint Library" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Select a custom row above to edit it. Built-in footprints can't be edited."
                           Foreground="Gray" FontStyle="Italic" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Names:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewNames, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="One or more names, comma-separated (e.g. 0805, 805) - any of them will match this footprint."
                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="L (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="3" Text="{Binding NewLengthMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="W (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="5" Text="{Binding NewWidthMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="H (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="7" Text="{Binding NewHeightMm, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Browse Image..." Padding="8,3" Click="Browse_Click"/>
                    <TextBlock Text="{Binding ImagePathDisplay}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="Orange" VerticalAlignment="Center"
                               Margin="0,0,10,0" TextWrapping="Wrap" MaxWidth="320"/>
                    <Button Content="Clear" Padding="8,3" Command="{Binding CancelEditCommand}"/>
                    <Button Content="{Binding SaveButtonText}" Padding="8,3" Margin="8,0,0,0" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Close" Padding="8,3" Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Footprints}" SelectedItem="{Binding SelectedFootprint}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Names" Binding="{Binding DisplayNames}" Width="220"/>
                <DataGridTextColumn Header="Length (mm)" Binding="{Binding LengthMm}" Width="100"/>
                <DataGridTextColumn Header="Width (mm)" Binding="{Binding WidthMm}" Width="100"/>
                <DataGridTextColumn Header="Height (mm)" Binding="{Binding HeightMm}" Width="100"/>
                <DataGridCheckBoxColumn Header="Custom" Width="70">
                    <DataGridCheckBoxColumn.Binding>
                        <!-- DataGridCheckBoxColumn defaults to a TwoWay binding (unlike text
                             columns), so even with DataGrid.IsReadOnly="True" it still tries to
                             attach a TwoWay binding and throws on a getter-only property like
                             IsCustom unless Mode is pinned to OneWay explicitly. -->
                        <Binding Path="IsCustom" Mode="OneWay"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
