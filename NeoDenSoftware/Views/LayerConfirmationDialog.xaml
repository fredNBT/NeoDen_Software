<Window x:Class="NeoDenSoftware.Views.LayerConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NeoDenSoftware.Models"
        Title="Confirm Layer Assignments" Height="420" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <x:Array x:Key="RoleOptions" Type="{x:Type models:GerberLayerRole}">
            <models:GerberLayerRole>TopPaste</models:GerberLayerRole>
            <models:GerberLayerRole>BottomPaste</models:GerberLayerRole>
            <models:GerberLayerRole>TopSoldermask</models:GerberLayerRole>
            <models:GerberLayerRole>BottomSoldermask</models:GerberLayerRole>
            <models:GerberLayerRole>Outline</models:GerberLayerRole>
            <models:GerberLayerRole>Ignore</models:GerberLayerRole>
        </x:Array>
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Confirm which extracted file maps to each PCB layer. Anything not recognized defaults to Ignore."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Continue" Width="90" IsDefault="True" Click="Continue_Click"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" RowHeight="44">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Preview" Width="72" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Thumbnail}" Width="64" Height="36" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Detected via" Binding="{Binding DetectionReason}" Width="1.5*" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="Layer"
                                         SelectedItemBinding="{Binding Role}"
                                         ItemsSource="{StaticResource RoleOptions}"
                                         Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
