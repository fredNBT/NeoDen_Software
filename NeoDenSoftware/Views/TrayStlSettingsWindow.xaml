<Window x:Class="NeoDenSoftware.Views.TrayStlSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray STL Generator Settings" Height="620" Width="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <!-- Save/Close pinned at the bottom, outside the ScrollViewer - the form keeps growing as
         settings are added, and with a fixed-height, non-resizable window and no scrolling the
         buttons ended up below the visible edge with no way to reach them. -->
    <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,8,16,16" HorizontalAlignment="Right">
        <TextBlock Text="{Binding StatusMessage}" Foreground="Orange" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Content="Save" Padding="12,4" Command="{Binding SaveCommand}" IsDefault="True"/>
        <Button Content="Close" Padding="12,4" Margin="8,0,0,0" Click="Close_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,16,16,0">
        <TextBlock Text="Tray STL Generator Settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="Variables used to build a tray-feeder parts tray STL (Create NeoDen4 File...) - one tray per distinct footprint among components with 'Tray Feeder' checked in the Feeder Setup tab. A solid box of fixed size, with pockets recessed into the top and a groove recessed along both long edges."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- No UpdateSourceTrigger=PropertyChanged - see FootprintLibraryWindow.xaml's comment
                 for why that eats decimal points mid-type on a double-typed property. LostFocus
                 (the default) commits the full typed string in one shot. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Box length (mm):" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BoxLengthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Box width (mm):" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BoxWidthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Box height (mm):" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BoxHeightMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pockets per tray:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PocketCount}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Extra length (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Added to the footprint's own LengthMm to get each pocket's X size."/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ExtraLengthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Extra width (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Added to the footprint's own WidthMm to get each pocket's Y size."/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ExtraWidthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Groove width (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Width of the recessed groove cut along both long edges of the box."/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding GrooveWidthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Groove depth (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="How far down from the top the edge groove is cut."/>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding GrooveDepthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Label depth (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="How far down from the top the component-name label is depressed."/>
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding TextDepthMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Label height (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Target printed height of the label text in mm - shrunk further automatically if it doesn't fit the available space."/>
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TextHeightMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Cutout size (mm):" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Side length of the small square notch above and below each pocket, merged flush into the pocket edge, same depth as the pocket - a fingernail catch reaching into the pocket to lift the part out. 0 turns it off."/>
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ComponentCutoutSizeMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Mounting hole diameter (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Diameter of the two round holes drilled all the way through the tray, one near each end. 0 turns them off."/>
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding MountingHoleDiameterMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Mounting hole inset (mm):" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Distance from each end of the tray to that hole's own center."/>
            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding MountingHoleInsetMm}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Pocket center hole (mm):" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Diameter of the round hole through the middle of each pocket, straight through the whole tray. Skipped just for a pocket too small to fit it. 0 turns it off."/>
            <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding PocketCenterHoleDiameterMm}"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" Margin="0,12,0,0"
                   Text="Pocket depth (Z) always matches the footprint's own HeightMm exactly - no extra clearance is added there. The label (each part's Value, e.g. 'CH340G') is centered at the top of the tray, in the margin strip above the pockets, at up to the height above - shrunk further if needed so it always fits, and only omitted entirely if there's essentially no usable space left."/>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
